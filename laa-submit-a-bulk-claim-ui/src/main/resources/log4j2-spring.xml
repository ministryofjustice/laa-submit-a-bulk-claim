<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" packages="io.sentry.log4j2">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p ${sys:PID} --- [%t] %-40.40c{1.} : %m%n"/>
        </Console>
        <Sentry name="Sentry" minimumEventLevel="ERROR" minimumBreadcrumbLevel="INFO"/>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="Sentry"/>
        </Root>
    </Loggers>
</Configuration>
